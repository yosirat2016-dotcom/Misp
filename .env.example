# MISP instance the sync service pushes into
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# Base URL where data/misp_feed/ is being served (see deploy/systemd/misp-feeds-http.service).
# From inside a Docker container running MISP, 127.0.0.1 means the container
# itself - use the Docker bridge gateway IP instead (find it with:
# ip addr show docker0 | grep "inet ").
FEED_SERVE_BASE_URL=http://172.17.0.1:8000

# Raw GitHub URL for sources.csv - this is what the scheduled sync pulls,
# so a git push to this file is what changes what gets ingested.
GITHUB_SOURCES_CSV_URL=https://raw.githubusercontent.com/yosirat2016-dotcom/Misp/main/scripts/sources.csv
