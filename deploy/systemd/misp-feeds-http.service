[Unit]
Description=Persistent HTTP server for data/misp_feed/ (MISP pulls feeds from here)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rata/Desktop/Misp/data/misp_feed
ExecStart=/usr/bin/python3 -m http.server 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
